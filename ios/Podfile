require_relative '../node_modules/react-native/scripts/react_native_pods'

platform :ios, '16.0'

prepare_react_native_project!

use_frameworks! :linkage => :static
use_modular_headers!

# ============================================================
# Resolve React Native / Permissions scripts
# ============================================================
def node_require(script)
  require Pod::Executable.execute_command(
    'node',
    [
      '-p',
      "require.resolve('#{script}', {paths: [process.argv[1]]})",
      __dir__
    ]
  ).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

# ============================================================
# Permissions
# ============================================================
setup_permissions([
  'Camera',
  'Microphone',
  'Notifications',
  'LocationAlways',
  'LocationWhenInUse',
  'PhotoLibrary',
  'PhotoLibraryAddOnly',
  'MediaLibrary'
])

# ============================================================
# Oeuvre Target
# ============================================================
target 'Oeuvre' do

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :fabric_enabled => false
  )

  # ==========================================================
  # Google ML Kit
  # ==========================================================
  pod 'GoogleMLKit/TextRecognitionChinese', '8.0.0'

  # ==========================================================
  # POST INSTALL
  # ==========================================================
  post_install do |installer|

    # React Native post install
    react_native_post_install(
      installer,
      config[:reactNativePath]
    )

    # ========================================================
    # Fix deployment target for ALL Pods
    # ========================================================
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      end
    end

    # ========================================================
    # fmt 11.0.2 + Xcode 26 compatibility fix
    #
    # Fix:
    # Call to consteval function
    # 'fmt::basic_format_string...' is not a constant expression
    # ========================================================

    fmt_base = File.join(
      installer.sandbox.pod_dir('fmt'),
      'include',
      'fmt',
      'base.h'
    )

    if File.exist?(fmt_base)

      content = File.read(fmt_base)

      patched_content = content.gsub(
        /^#\s*define FMT_USE_CONSTEVAL 1$/,
        '# define FMT_USE_CONSTEVAL 0'
      )

      if patched_content != content

        File.chmod(0644, fmt_base)
        File.write(fmt_base, patched_content)

        puts "✅ Applied fmt 11.0.2 Xcode 26 compatibility fix"

      else

        puts "ℹ️ fmt consteval already patched or pattern not found"

      end

    else

      puts "⚠️ fmt/base.h not found"

    end

  end

end
require_relative '../node_modules/react-native/scripts/react_native_pods'

platform :ios, '16.0'

prepare_react_native_project!

use_frameworks! :linkage => :static

use_modular_headers!

# ============================================================
# Helper to load React Native / React Native Permissions scripts
# ============================================================

def node_require(script)
  require Pod::Executable.execute_command(
    'node',
    [
      '-p',
      "require.resolve('#{script}', {paths: [process.argv[1]]})",
      __dir__
    ]
  ).strip
end

# React Native
node_require('react-native/scripts/react_native_pods.rb')

# React Native Permissions
node_require('react-native-permissions/scripts/setup.rb')


# ============================================================
# Permissions
# ============================================================

setup_permissions([
  'Camera',
  'Microphone',
  'Notifications',
  'LocationAlways',
  'LocationWhenInUse',
  'PhotoLibrary',
  'PhotoLibraryAddOnly',
  'MediaLibrary'
])


# ============================================================
# Oeuvre
# ============================================================

target 'Oeuvre' do

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :fabric_enabled => false
  )


  # ==========================================================
  # Google MLKit Text Recognition
  # ==========================================================

  pod 'GoogleMLKit/TextRecognitionChinese', '8.0.0'


  # ==========================================================
  # POST INSTALL
  # ==========================================================

  post_install do |installer|

    react_native_post_install(
      installer,
      config[:reactNativePath]
    )


    # ========================================================
    # Force iOS Deployment Target 16.0 for ALL Pods
    # ========================================================

    installer.pods_project.targets.each do |target|

      target.build_configurations.each do |build_config|

        build_config.build_settings[
          'IPHONEOS_DEPLOYMENT_TARGET'
        ] = '16.0'

      end

    end


    # ========================================================
    # FIX:
    #
    # fmt + Apple Clang 21 / Xcode 26.4+
    #
    # Error:
    #
    # Call to consteval function
    # 'fmt::basic_format_string<...>'
    # is not a constant expression
    #
    # This patches fmt/base.h so Apple Clang does not use
    # consteval for FMT_STRING.
    # ========================================================

    fmt_base = File.join(
      installer.sandbox.pod_dir('fmt'),
      'include',
      'fmt',
      'base.h'
    )

    if File.exist?(fmt_base)

      content = File.read(fmt_base)

      # ------------------------------------------------------
      # Primary fmt workaround
      #
      # Original:
      #
      # #elif defined(__apple_build_version__) &&
      #       __apple_build_version__ < 14000029L
      #
      # Changed to:
      #
      # #elif defined(__apple_build_version__)
      # ------------------------------------------------------

      patched = content.gsub(
        '#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L',
        '#elif defined(__apple_build_version__)'
      )

      if patched != content

        File.chmod(0644, fmt_base)

        File.write(
          fmt_base,
          patched
        )

      end

    end


    # ========================================================
    # Additional protection for fmt / RCT-Folly
    #
    # Keeps C++ standard at C++17 and explicitly disables
    # consteval for these targets.
    # ========================================================

    installer.pods_project.targets.each do |target|

      if target.name == 'fmt' || target.name == 'RCT-Folly'

        target.build_configurations.each do |build_config|

          build_config.build_settings[
            'CLANG_CXX_LANGUAGE_STANDARD'
          ] = 'c++17'


          definitions =
            build_config.build_settings[
              'GCC_PREPROCESSOR_DEFINITIONS'
            ]


          if definitions.nil?

            definitions = [
              '$(inherited)'
            ]

          elsif definitions.is_a?(String)

            definitions = [
              definitions
            ]

          else

            definitions = definitions.dup

          end


          unless definitions.include?(
            'FMT_USE_CONSTEVAL=0'
          )

            definitions << 'FMT_USE_CONSTEVAL=0'

          end


          build_config.build_settings[
            'GCC_PREPROCESSOR_DEFINITIONS'
          ] = definitions

        end

      end

    end

  end

end

	let response;
	try {
	response = pm.response.json();
	
	let inner = response.d ? JSON.parse(response.d) : response;
	console.log(inner);
	
	const template = `<pre>{{pretty}}</pre>`;
	function createPayload() {
	return { pretty: JSON.stringify(inner, null, 2) };
	}
	pm.visualizer.set(template, createPayload());
	pm.test("Response parsed and visualized successfully", function () {
	pm.expect(inner).to.be.an('object');
	});
	} catch (e) {
	pm.test("Response parsing failed", function () {
	pm.expect.fail("Parsing error: " + e.message);
	});
	}

  ---- for page -----

  try {

    const response = pm.response.json();

    let raw = response.d;

    // Remove script field before JSON.parse
    raw = raw.replace(
        /"script":"<script[\s\S]*?<\/script>",/g,
        ""
    );

    // Parse cleaned JSON
    const parsedData = JSON.parse(raw);

    // Visualizer
    const template = `
        <pre style="
            white-space: pre-wrap;
            word-wrap: break-word;
            padding: 12px;
            background: #f4f4f4;
            border-radius: 6px;
            font-size: 12px;
        ">
{{data}}
        </pre>
    `;

    pm.visualizer.set(template, {
        data: JSON.stringify(parsedData, null, 2)
    });

} catch (err) {

    console.log(err);

    pm.visualizer.set(
        "<h3 style='color:red'>Parsing Error</h3><pre>{{msg}}</pre>",
        { msg: err.message }
    );
}

